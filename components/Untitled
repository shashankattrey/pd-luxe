// components/RadarChartClient.tsx
"use client";

import {
  Radar,
  RadarChart,
  PolarGrid,
  PolarAngleAxis,
  ResponsiveContainer,
} from "recharts";

export default function RadarChartClient({ data }: { data: any[] }) {
  return (
    <ResponsiveContainer width="100%" height="100%">
      <RadarChart cx="50%" cy="50%" outerRadius="80%" data={data}>
        <PolarGrid stroke="rgba(255,255,255,0.1)" />
        <PolarAngleAxis
          dataKey="subject"
          tick={{ fill: "rgba(255,255,255,0.4)", fontSize: 10 }}
        />
        <Radar
          name="Investor DNA"
          dataKey="value"
          stroke="#D4AF37"
          fill="#D4AF37"
          fillOpacity={0.3}
        />
      </RadarChart>
    </ResponsiveContainer>
  );
}